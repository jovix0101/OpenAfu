# ---------------------------------------------------------------------------
# 原始产物：体积大、含第三方版权内容，或含真实设备的抓包 / 日志 / 个人信息。
# 这些文件只留在本机，不进版本库。详见 docs/07-privacy.md。
# 注意：.gitignore 不支持行内注释，注释必须单独占一行。
# ---------------------------------------------------------------------------

# 从手机 pulled 的蚂蚁阿福 APK 与解出的 dex
/apk/
# jadx 全量反编译（约 5 万个类）
/decomp/
# adb bugreport 与解压出的整机日志
/bug/
# 本地 JDK（跑 jadx 用）
/tools/
# Python 虚拟环境
/.venv/
/.venv-ag/

# 本地 Swift 工具打包出来的 .app 宿主与零散二进制
*.app/
/blescan
/blescan.plist

# 根目录的早期实验脚本写死了真实设备 UUID 与个人资料，src/ 里是脱敏版
/*.swift
/*.py

# 真实测量抓包与手机截图：含体重、阻抗、姓名、设备标识
/captures/
/shots/

.DS_Store
**/.DS_Store
